# ==============================================================================
# task-api Environment Configuration Template
# Salin file ini ke .env untuk konfigurasi lokal:
#   cp .env.example .env
# JANGAN PERNAH menyimpan kredensial atau secret produksi ke dalam repository!
# ==============================================================================

# Port server HTTP (default: 8081; port 8080 umumnya dipakai service lain)
PORT=8081

# URL koneksi database PostgreSQL utama (WAJIB)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<disable|require>
DATABASE_URL=postgres://taskapi:devpassword@localhost:5432/taskdb?sslmode=disable

# Secret key untuk penandatanganan token JWT HS256 (WAJIB)
# Syarat: minimal 32 karakter unik. Aplikasi akan fail-fast saat startup jika kosong/<32 char.
# Contoh generate aman di terminal: openssl rand -base64 32
JWT_SECRET=change-this-to-a-very-secure-random-secret-key-min-32-chars

# URL koneksi database khusus Integration Test (Opsional untuk running biasa, wajib untuk integration test)
# Guard keamanan: hostname HARUS 127.0.0.1 atau ::1 dan nama database HARUS berakhiran '_test'
TEST_DATABASE_URL=postgres://taskapi:devpassword@127.0.0.1:5432/taskdb_test?sslmode=disable

# Origin frontend yang diizinkan mengakses API lewat browser (CORS).
# Pisahkan dengan koma. Kosongkan jika frontend belum ada / di-serve dari origin yang sama.
# Contoh: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=

# Interval pemindaian background worker (format durasi Go, mis. 5m, 30s)
REMINDER_INTERVAL=5m
REMINDER_ENABLED=true

# ------------------------------------------------------------------------------
# Konfigurasi container PostgreSQL (docker-compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=taskdb
POSTGRES_PORT=5432
